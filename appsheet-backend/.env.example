# Copia este archivo a .env y llena los valores. No subas .env al repositorio.

# --- AppSheet (Manage → Integrations → IN: from cloud services to your app) ---
# Las tres van juntas. Vacías: el servidor arranca pero no lee ni escribe la app.
APPSHEET_APP_ID=
APPSHEET_ACCESS_KEY=
# Correo con el que el backend llama a la API. Es el USEREMAIL() en los filtros de seguridad.
# Usa la cuenta institucional dueña de la app.
APPSHEET_RUN_AS=
# https://api.appsheet.com (o https://eu.appsheet.com si la app está en la región de la UE)
APPSHEET_BASE_URL=https://api.appsheet.com
APPSHEET_LOCALE=en-US
APPSHEET_TIMEZONE=Central Standard Time (Mexico)
# Deja vacío para no registrar la bitácora de validaciones.
APPSHEET_TABLA_VALIDACIONES=Validaciones

# Enlace de la app que ve el alumno al terminar su registro (https://www.appsheet.com/start/<id>)
APPSHEET_APP_URL=

# --- Registro con cuenta institucional (scrap-uat-service) ---
# Vacía = registro deshabilitado
UAT_SERVICIO_URL=http://localhost:3100
# La API_GATEWAY_KEYS del scraper (openssl rand -hex 32)
UAT_SERVICIO_CLAVE=
UAT_DOMINIO_ALUMNOS=alumnos.uat.edu.mx
# Situaciones del portal que cuentan como inscrito (se compara palabra por palabra)
UAT_SITUACIONES_ACTIVAS=ACTIVO,INSCRITO,REINSCRITO,REGULAR,IRREGULAR,VIGENTE
UAT_ESPERA=90s
# Orígenes del frontend que pueden llamar a /api/v1/alumnos/verificar
CORS_ORIGENES=http://localhost:5175

# --- Seguridad (al menos 24 caracteres; genera con: openssl rand -hex 24) ---
WEBHOOK_SECRETO=
API_TOKEN=
ANALIZADOR_TOKEN=

# --- Fotos ---
# drive: Google Drive con cuenta de servicio (recomendado)
# local: un directorio con la misma estructura que la carpeta de la app
# appsheet: URL de AppSheet (solo si "Require Image and File URL Signing" está desactivado)
IMAGENES_FUENTE=drive
# ID de la carpeta de la app en Drive (appsheet/data/<App>-<n>) o de su subcarpeta Solicitudes_Images
DRIVE_CARPETA_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google.json
IMAGENES_DIR_LOCAL=
APPSHEET_APP_NAME=

# --- REPUVE (la consulta la hace el analizador con Playwright) ---
REPUVE_HABILITADO=true
# Lo que el backend espera la respuesta del analizador, incluida la fila de consultas
REPUVE_ESPERA_MAX=5m
# Variables del analizador: tiempo por consulta, pausa entre consultas y caché por NIV
REPUVE_TIMEOUT=2m
REPUVE_INTERVALO_MIN=20s
REPUVE_CACHE_TTL=6h
# Directorio donde guardar una traza de Playwright de cada consulta fallida (vacío = no)
REPUVE_DEPURACION_DIR=
# Solo sin Docker: false abre una ventana de Chromium visible
REPUVE_HEADLESS=true

# --- Pase con código QR (se emite al aprobar) ---
# Firma los códigos. Al menos 32 caracteres (openssl rand -hex 32). Vacío = no se emiten pases.
PASE_SECRETO=
# URL https pública del backend; AppSheet carga la imagen del QR desde <URL_PUBLICA>/pases/qr/...
URL_PUBLICA=
APPSHEET_TABLA_PASES=Pases
# Vigencia: días desde la emisión, o una fecha fija (p. ej. fin del ciclo escolar) que tiene prioridad
PASE_DIAS=365
PASE_VENCE=

# --- Decisión y operación ---
# false: el backend llena la revisión pero la aprobación final la publica una persona
AUTO_APROBAR=true
BARRIDO_INTERVALO=15m
BARRIDO_DIAS=14
TRABAJADORES=2
LOG_NIVEL=info
