{
  "name": "control-acceso-vehicular-front-end",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:caseta": "vite --mode caseta",
    "dev:admin": "vite --mode admin",
    "build:caseta": "vite build --mode caseta",
    "build:admin": "vite build --mode admin",
    "build": "npm run typecheck && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:caseta && npm run build:admin",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
