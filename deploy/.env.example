# Variables del stack (docker-compose.yml). En el VPS: deploy/.env con permisos 600.
# generar-env.sh crea el archivo y llena los secretos con openssl.

# --- Dominios (Cloudflare → Traefik de Dokploy) ---
DOMINIO_BACKEND=hackathon.452111.xyz
DOMINIO_FRONTEND=hackathonfrontend.452111.xyz
DOMINIO_SCRAP=hackathonapi.452111.xyz

# --- Origen de datos: Google Sheets directo (piloto sin plan Enterprise) ---
# ID de la hoja (entre /d/ y /edit). La cuenta de servicio de credenciales/
# necesita Editor sobre la hoja y Lector sobre la carpeta de fotos.
# Con este modo, AppSheet sigue siendo el formulario pero el backend no usa su API,
# y las tres variables APPSHEET_APP_ID/ACCESS_KEY/RUN_AS deben quedar vacías.
GOOGLE_SHEETS_ID=

# --- O bien la API de AppSheet (requiere plan Enterprise). Sin estos tres valores
# ni GOOGLE_SHEETS_ID, el backend arranca pero no lee ni escribe solicitudes. ---
APPSHEET_APP_ID=
APPSHEET_ACCESS_KEY=
APPSHEET_RUN_AS=
APPSHEET_BASE_URL=https://api.appsheet.com
APPSHEET_LOCALE=en-US
APPSHEET_TIMEZONE=Central Standard Time (Mexico)
APPSHEET_TABLA_VALIDACIONES=Validaciones
APPSHEET_TABLA_PASES=Pases
# Enlace de la app que ve el alumno al terminar su registro (https://www.appsheet.com/start/<id>)
APPSHEET_APP_URL=

# --- Fotos en Drive: PENDIENTE (ID de carpeta + credenciales/cuenta-servicio.json) ---
IMAGENES_FUENTE=drive
DRIVE_CARPETA_ID=

# --- Secretos (generar-env.sh) ---
WEBHOOK_SECRETO=
API_TOKEN=
ANALIZADOR_TOKEN=
PASE_SECRETO=
# Compartida con scrap-uat-service (su API_GATEWAY_KEYS)
UAT_SERVICIO_CLAVE=

# --- Registro de alumnos con cuenta institucional ---
UAT_DOMINIO_ALUMNOS=alumnos.uat.edu.mx
UAT_SITUACIONES_ACTIVAS=ACTIVO,INSCRITO,REINSCRITO,REGULAR,IRREGULAR,VIGENTE
CORS_ORIGENES=https://hackathonfrontend.452111.xyz

# --- Pases QR ---
URL_PUBLICA=https://hackathon.452111.xyz
PASE_DIAS=365
PASE_VENCE=

# --- REPUVE (el portal rechaza navegadores automatizados con reCAPTCHA: queda NO_DISPONIBLE) ---
REPUVE_HABILITADO=true
REPUVE_ESPERA_MAX=5m
REPUVE_TIMEOUT=2m
REPUVE_INTERVALO_MIN=20s
REPUVE_CACHE_TTL=6h

# --- Operación ---
# Vacías = valor según el modo: con GOOGLE_SHEETS_ID, aprobación humana y barrido
# cada minuto (no hay bot); con la API de AppSheet, aprobación automática y 15m.
AUTO_APROBAR=
BARRIDO_INTERVALO=
BARRIDO_DIAS=14
TRABAJADORES=2
LOG_NIVEL=info
ZONA_HORARIA=America/Monterrey
